{
  "name": "github-pre-publish-checker",
  "version": "0.1.0",
  "description": "GitHubへ公開する前にリポジトリの品質を自動チェックするローカルCLIツール",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "gh-check": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup src/index.ts --format esm --dts",
    "dev": "npx tsx src/index.ts",
    "check": "npx tsx src/index.ts .",
    "test": "npx tsx --test tests/**/*.test.ts"
  },
  "keywords": [
    "github",
    "checker",
    "cli",
    "quality"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
