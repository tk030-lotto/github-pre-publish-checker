{
  "name": "github-pre-publish-checker",
  "version": "0.1.0",
  "description": "GitHubへ公開する前にリポジトリの品質を自動チェックするローカルCLIツール",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "gh-check": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npx tsup",
    "start": "node dist/server/index.js",
    "dev": "npx tsx src/server/index.ts",
    "check": "npx tsx src/index.ts .",
    "test": "npx tsx --test tests/checkers.test.ts tests/e2e.test.ts tests/reporter.test.ts tests/server.test.ts",
    "deploy": "gh-pages -d docs"
  },
  "keywords": [
    "github",
    "checker",
    "cli",
    "quality"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "gh-pages": "^6.1.1"
  }
}
